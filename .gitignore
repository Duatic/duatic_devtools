# Deployment-specific: which repositories are in the release set, and which packages are not
# released. The tooling ships the format as .example files and takes the content as input.
packaging/workspace/repos.txt
packaging/workspace/exclude.txt

# Generated by gen_release_set.sh
packaging/workspace/packages.txt
packaging/archive/lists/
packaging/archive/rosdep/rosdep-*.yaml
packaging/tests/rosdep/

# Clones and build output
packaging/workspace/src/
packaging/workspace/staging/
packaging/archive/out/
packaging/tests/out/
packaging/archive/dist/
packaging/archive/aptly/
packaging/builder/out/
packaging/builder/dist/
packaging/builder/repo/

# Archive signing key
packaging/archive/gnupg/
packaging/builder/gnupg/

# Python
__pycache__/
*.pyc
