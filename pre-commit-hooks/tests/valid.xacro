<?xml version="1.0"?>
<!-- Fixture for the hook tests: a valid file that is already formatted and has no findings. -->
<robot name="fixture" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="arm_"/>

  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="radius" value="0.05"/>

  <xacro:macro name="wheel"
               params="name
                       parent
                       *origin">

    <link name="${prefix}${name}"/>

    <joint name="${prefix}${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>

  </xacro:macro>

  <link name="base_link"/>

  <xacro:wheel name="front" parent="base_link">
    <origin xyz="0 0 ${radius}" rpy="0 0 0"/>
  </xacro:wheel>

</robot>
