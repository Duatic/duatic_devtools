<?xml version="1.0"?>
<robot name="r" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <origin xyz="0.05 7.5 1" rpy="0 0.5 5"/>

  <mass value="1"/>

  <limit lower="100" upper="100" effort="10" velocity="1e-3"/>

  <origin xyz="${x} 0.0 0.0"/>
  <origin xyz="0 0 1"/>

  <xacro:property name="p" value="0.050"/>

  <xacro:m a="0.050"/>

  <link name="0.050"/>

</robot>
